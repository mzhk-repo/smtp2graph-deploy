# smtp2graph experimental configuration contract.
# This file contains only safe development values and secret references.
# Do not copy it to a production .env file. Production material is managed by
# SOPS + age and Docker Secrets after the applicable roadmap gates.

# === Базова ідентифікація середовища та gateway ===
# Версія contract потрібна validator-у; DEPLOY_ENVIRONMENT визначає development або production safeguards.
CONFIG_CONTRACT_VERSION=experimental-v1
DEPLOY_ENVIRONMENT=development
# Режим gateway та тип Graph credential; значення не є Secret.
SMTP2GRAPH_MODE=full
GRAPH_AUTH_MODE=certificate
# === SMTP listener і policy ===
# Адреса/порт listener, ліміт повідомлення, sessions/rate та дозволені source CIDR для SMTP клієнтів.
SMTP_BIND_ADDRESS=127.0.0.1
SMTP_LISTEN_PORT=2525
SMTP_MAX_MESSAGE_BYTES=26214400
SMTP_MAX_SESSIONS_PER_IP=5
SMTP_MESSAGES_PER_MINUTE=30
SMTP_ALLOWED_SOURCE_CIDRS=127.0.0.1/32
# Єдиний canonical runtime sender. Deploy виводить із нього global SMTP sender allowlist.
GRAPH_SENDER_MAILBOX=noreply@example.invalid
# Retry Graph delivery та allowlist recipient лише для non-production rehearsal.
SEND_RETRY_LIMIT=1
SEND_RETRY_INTERVAL_MINUTES=1
NONPRODUCTION_RECIPIENT_ALLOWLIST=recipient@example.invalid
# === Queue, retention та Swarm topology ===
# Межі локальної queue, host storage, retention і назви stack/overlay; не містять Secret values.
QUEUE_MAX_BYTES=1073741824
QUEUE_REJECT_THRESHOLD_PERCENT=80
SMTP2GRAPH_STORAGE_ROOT=/data
SMTP2GRAPH_STORAGE_HOST_PATH=/srv/smtp2graph/dev/data
SMTP2GRAPH_IMAGE_DIGEST=ghcr.io/example/smtp2graph@sha256:REPLACE_WITH_TASK_5_3_DIGEST
FAILED_PAYLOAD_RETENTION_DAYS=7
LOG_RETENTION_DAYS=30
SWARM_STACK_NAME=smtp2graph
SWARM_OVERLAY_NETWORK=smtp2graph_internal
# Manual backup destinations. Scheduler is managed outside this repository.
SMTP2GRAPH_BACKUP_LOCAL_DIR=/srv/smtp2graph/dev/backups
SMTP2GRAPH_BACKUP_RCLONE_REMOTE=REPLACE_WITH_RCLONE_REMOTE
SMTP2GRAPH_BACKUP_RCLONE_PATH=smtp2graph/dev
SMTP2GRAPH_BACKUP_LOCAL_RETENTION_COUNT=7
SMTP2GRAPH_BACKUP_CLOUD_RETENTION_COUNT=30
# === TLS, ACME та Secret mapping ===
# SMTP TLS hostname, шляхи локального issuance і root-only names-only Docker Secret mapping.
SMTP_TLS_FQDN=smtp-int.ldubgd.edu.ua
# Контакт ACME account; не використовується як SMTP sender або recipient.
TLS_ACME_EMAIL=operator@example.invalid
TLS_ACME_STATE_DIR=/srv/smtp2graph/dev/acme
TLS_OUTPUT_DIR=/srv/smtp2graph/dev/tls
TLS_CERTIFICATE_FILE=/srv/smtp2graph/dev/tls/fullchain.pem
TLS_PRIVATE_KEY_FILE=/srv/smtp2graph/dev/tls/privkey.pem
TLS_SECRET_MAPPING_FILE=/srv/smtp2graph/dev/smtp2graph.env
# Cloudflare DNS-01 metadata і token для TLS issuance; token належить лише SOPS.
CLOUDFLARE_ZONE_ID=REPLACE_WITH_CLOUDFLARE_ZONE_ID
CLOUDFLARE_DNS_API_TOKEN=REPLACE_WITH_SOPS_ENCRYPTED_SECRET

# === M365 qualification inputs ===
# Значення нижче потрібні лише для isolated non-production Graph tests; реальні Secret values — тільки у env.*.enc.
# Recipient для позитивного Graph send test; це не runtime SMTP recipient policy.
ADDITIONALRECIPIENT=recipient@example.invalid
AZURE_CERT_PRIVATE_KEY_PATH=/run/secrets/graph-private-key
# Mailbox тільки для negative Graph authorization scenario.
DENIED_MAILBOX=denied@example.invalid
GRAPH_TENANT_ID=REPLACE_WITH_SOPS_ENCRYPTED_SECRET
GRAPH_CLIENT_ID=REPLACE_WITH_SOPS_ENCRYPTED_SECRET
GRAPH_CERTIFICATE_THUMBPRINT=REPLACE_WITH_SOPS_ENCRYPTED_SECRET
GRAPH_CERT_PRIVATE_KEY_PEM=REPLACE_WITH_SOPS_ENCRYPTED_SECRET
GRAPH_CLIENT_SECRET=REPLACE_WITH_SOPS_ENCRYPTED_SECRET
# === Runtime Secret sources ===
# Docker Secret source у форматі username<TAB>password<TAB>allowed-sender CSV; sender scope має дорівнювати GRAPH_SENDER_MAILBOX у single-mailbox MVP.
SMTP_USERS_TSV=REPLACE_WITH_SOPS_ENCRYPTED_SECRET
TLS_CERTIFICATE_PEM=REPLACE_WITH_SOPS_ENCRYPTED_SECRET
TLS_PRIVATE_KEY_PEM=REPLACE_WITH_SOPS_ENCRYPTED_SECRET

# Docker Secret references only; never place secret values here.
GRAPH_TENANT_ID_SECRET_NAME=REPLACE_WITH_VERSIONED_SECRET_NAME
GRAPH_CLIENT_ID_SECRET_NAME=REPLACE_WITH_VERSIONED_SECRET_NAME
GRAPH_CREDENTIAL_SECRET_NAME=REPLACE_WITH_VERSIONED_SECRET_NAME
GRAPH_CERTIFICATE_THUMBPRINT_SECRET_NAME=REPLACE_WITH_VERSIONED_SECRET_NAME
SMTP_CREDENTIALS_SECRET_NAME=REPLACE_WITH_VERSIONED_SECRET_NAME
TLS_CERTIFICATE_SECRET_NAME=REPLACE_WITH_VERSIONED_SECRET_NAME
TLS_PRIVATE_KEY_SECRET_NAME=REPLACE_WITH_VERSIONED_SECRET_NAME
