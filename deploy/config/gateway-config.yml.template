# This template contains no credential values. scripts/entrypoint.sh replaces
# only the explicit placeholders using Docker Secret files and allowlisted inputs.
mode: __SMTP2GRAPH_MODE__
send:
  appReg:
    tenant: __GRAPH_TENANT_ID__
    id: __GRAPH_CLIENT_ID__
__GRAPH_CREDENTIAL_BLOCK__
  retryLimit: __SEND_RETRY_LIMIT__
  retryInterval: __SEND_RETRY_INTERVAL_MINUTES__
  forceMailbox: __GRAPH_SENDER_MAILBOX__
storage:
  rootPath: __SMTP2GRAPH_STORAGE_ROOT__
  maxBytes: __QUEUE_MAX_BYTES__
  rejectThresholdPercent: __QUEUE_REJECT_THRESHOLD_PERCENT__
observability:
  # This listener is reachable only through the encrypted Swarm overlay.
  listenAddress: '0.0.0.0'
  port: 9464
receive:
  port: __SMTP_LISTEN_PORT__
  listenAddress: __SMTP_BIND_ADDRESS__
  # STARTTLS: SMTP AUTH is permitted only after the TLS upgrade.
  secure: false
  tlsKeyPath: __SMTP_TLS_KEY_PATH__
  tlsCertPath: __SMTP_TLS_CERT_PATH__
  allowInsecureAuth: false
  maxSize: __SMTP_MAX_SIZE_KIB__
  ipWhitelist:
__SMTP_ALLOWED_SOURCE_CIDRS__
  allowedFrom:
__SMTP_ALLOWED_SENDER_ADDRESSES__
  requireAuth: true
  maxSessionsPerIp: __SMTP_MAX_SESSIONS_PER_IP__
  rateLimit:
    duration: 60
    limit: __SMTP_MESSAGES_PER_MINUTE__
  users:
__SMTP_USERS__
