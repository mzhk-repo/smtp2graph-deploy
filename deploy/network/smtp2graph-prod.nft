destroy table inet smtp2graph_prod

table inet smtp2graph_prod {
  chain input {
    type filter hook input priority filter; policy accept;
    tcp dport 2525 ip saddr @smtp2graph_prod_smtp_clients accept
    tcp dport 2525 drop
  }

  set smtp2graph_prod_smtp_clients {
    type ipv4_addr
    flags interval
    elements = { __SMTP_ALLOWED_SOURCE_CIDRS__ }
  }
}
