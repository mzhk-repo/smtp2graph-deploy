diff --git a/.github/workflows/release-ci.yml b/.github/workflows/release-ci.yml
new file mode 100644
index 0000000..11ec3a3
--- /dev/null
+++ b/.github/workflows/release-ci.yml
@@ -0,0 +1,53 @@
+name: Secure build and release evidence
+
+on:
+  pull_request:
+    branches: [dev, main]
+  push:
+    branches: [dev, main]
+    tags: ['v*']
+
+permissions:
+  contents: write
+  packages: write
+  pull-requests: read
+
+jobs:
+  validate-pr:
+    name: Validate pull request
+    if: github.event_name == 'pull_request'
+    uses: mzhk-repo/shared-workflows/.github/workflows/shared-ci-cd.yml@main # reviewed mutable exception; all Action/image uses are centralized in shared CI/CD
+    secrets: inherit
+    with:
+      environment_name: development
+      deploy: false
+      use_ansible: true
+      build_and_push_docker: false
+      validation_script_path: scripts/ci-validate.sh
+
+  publish-development:
+    name: Build and push development image
+    if: github.event_name == 'push' && github.ref == 'refs/heads/dev'
+    uses: mzhk-repo/shared-workflows/.github/workflows/shared-ci-cd.yml@main # reviewed mutable exception; all Action/image uses are centralized in shared CI/CD
+    secrets: inherit
+    with:
+      environment_name: development
+      deploy: false
+      use_ansible: true
+      build_and_push_docker: true
+      push_docker_image: true
+      docker_image_name: smtp2graph-build
+      validation_script_path: scripts/ci-validate.sh
+
+  publish-release:
+    name: Build, publish and retain release evidence
+    if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')
+    uses: mzhk-repo/shared-workflows/.github/workflows/shared-ci-cd.yml@main # reviewed mutable exception; all Action/image uses are centralized in shared CI/CD
+    secrets: inherit
+    with:
+      environment_name: production
+      deploy: false
+      use_ansible: true
+      build_and_push_docker: true
+      push_docker_image: true
+      docker_image_name: smtp2graph-build
+      validation_script_path: scripts/ci-validate.sh
+      release_tag: ${{ github.ref_name }}
+      control_plane_sha: fe3e461911c68949d9586b52a9c3253fa9795a45
